#define ASCENDC_DUMP 0
#define ASCENDC_TILING_KEY_VAR_IMPL 0
#include <utils/debug/asc_printf.h>
#include <utils/debug/asc_assert.h>
#define PYPTO_V41_MOE_PRIVATE_PYPTO_SYM_BUFFER_ADAPTER_HPP
#include "moe_pipeline_compute.hpp"
struct PeerWindows { uint64_t address[MOE_EP]; };
extern "C" __global__ __mix__(1, 2) void lib_mega_moe(
    __gm__ bfloat16_t* x, __gm__ int32_t* ids, __gm__ float* prob, __gm__ bfloat16_t* y,
    __gm__ uint8_t* w1, __gm__ uint8_t* s1, __gm__ uint8_t* w3, __gm__ uint8_t* s3,
    __gm__ uint8_t* w2, __gm__ uint8_t* s2, __gm__ uint8_t* sw1, __gm__ uint8_t* ss1,
    __gm__ uint8_t* sw3, __gm__ uint8_t* ss3, __gm__ uint8_t* sw2, __gm__ uint8_t* ss2,
    PeerWindows peers, uint32_t rank, uint32_t active) {
    using namespace deep_gemm;
    constexpr auto& workspace=mega_moe::layout::kWorkspace<MOE_EP,MOE_EP*MOE_EXPERTS,1,MOE_TOKENS,MOE_TOPK,MOE_HIDDEN,MOE_INTER>;
    layout::SymBuffer<> sym{};
    sym.base=peers.address[rank]; sym.rank_idx=rank;
    for (uint32_t r=0;r<MOE_EP;++r) sym.offsets[r]=peers.address[r]-peers.address[rank];
    auto core=static_cast<uint32_t>(block_idx);
    uint32_t lane=0;
#ifdef __DAV_VEC__
    lane=asc_get_sub_block_id();
#endif
    asc_init();
    CoreTopology<true> topology{32};
    v41_official_input::publish<workspace>(sym.get_base_ptr<__gm__ uint8_t*>(),
        reinterpret_cast<__gm__ uint8_t*>(x),nullptr,ids,prob,y,active,2*core+lane,topology);
    v41_official_input::publication_fence(lane);
    auto weights=mega_moe::layout::make_original_weights(w1,s1,w3,s3,w2,s2,sw1,ss1,sw3,ss3,sw2,ss2);
    mega_moe::mega_moe_device<MOE_EP,MOE_EP*MOE_EXPERTS,1,MOE_TOKENS,MOE_TOPK,MOE_HIDDEN,MOE_INTER>(
        y,nullptr,weights,active,10.0f,sym,core,lane,topology
#if MOE_COMPACT_WAVES
        ,reinterpret_cast<__gm__ uint32_t*>(ids),reinterpret_cast<__gm__ uint32_t*>(prob)
#endif
    );
}
